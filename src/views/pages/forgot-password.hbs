<div class="auth-page">
  <div class="auth-container">
    <div class="auth-card">
      <h1>Recuperar Contraseña</h1>
      <p class="auth-subtitle">Ingresa tu email y te enviaremos un enlace para restablecer tu contraseña</p>

      <form id="forgotPasswordForm" class="auth-form">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required placeholder="tu@email.com" autocomplete="email" />
        </div>

        <button type="submit" class="btn btn-primary btn-block">
          Enviar Enlace de Recuperación
        </button>
      </form>

      <div class="auth-links">
        <a href="/login">← Volver al inicio de sesión</a>
      </div>
    </div>
  </div>
</div>

<script src="/static/js/forgot-password.js"></script>