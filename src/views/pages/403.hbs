  border-radius: 16px; padding: 60px 40px; text-align: center; max-width: 500px; box-shadow: 0 20px 60px rgba(0, 0, 0,
  0.3); } .error-icon { font-size: 80px; margin-bottom: 20px; } .error-container h1 { font-size: 72px; margin: 0; color:
  #f5576c; font-weight: 700; } .error-container h2 { font-size: 28px; margin: 10px 0 20px 0; color: #333; }
