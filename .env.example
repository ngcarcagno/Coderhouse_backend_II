# ========================================
# ENVIRONMENT CONFIGURATION - EXAMPLE
# ========================================
# Copia este archivo como .env o .env.test y configura tus valores

# ========================================
# GENERAL
# ========================================
NODE_ENV=development
PORT=8080

# ========================================
# DATABASE (MongoDB)
# ========================================
MONGO_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<DB_CLUSTER>/<DB_NAME>?retryWrites=true&w=majority&appName=<DB_APP_NAME>

DB_USER=tu_usuario_mongodb
DB_PASSWORD=tu_password_mongodb
DB_NAME=nombre_base_datos
DB_CLUSTER=cluster.mongodb.net
DB_APP_NAME=NombreApp

DB_PORT=27017
DB_MAX_POOL_SIZE=10
DB_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000

# ========================================
# JWT & SECURITY
# ========================================
JWT_SECRET=tu-secret-key-super-segura-cambiala
JWT_EXPIRES_IN=24h

# JWT para recuperación de contraseña
JWT_RESET_SECRET=tu-reset-secret-key-diferente
JWT_RESET_EXPIRES_IN=1h

# ========================================
# EMAIL CONFIGURATION
# ========================================
# Para Gmail:
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Credenciales de email
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-app-password

# Nombre que aparecerá como remitente
EMAIL_FROM_NAME=E-commerce Backend II

# ========================================
# FRONTEND URLs
# ========================================
# URL del frontend para links en emails
FRONTEND_URL=http://localhost:3000
RESET_PASSWORD_PATH=/reset-password

# ========================================
# NOTAS IMPORTANTES
# ========================================
# 
# Para Gmail:
# 1. Activar verificación en 2 pasos en tu cuenta Google
# 2. Generar una "Contraseña de aplicación" en: https://myaccount.google.com/apppasswords
# 3. Usar esa contraseña en EMAIL_PASSWORD (no tu contraseña normal)
#
# Para otros servicios de email (Outlook, Yahoo, etc.):
# - Cambiar EMAIL_SERVICE, EMAIL_HOST, EMAIL_PORT según el proveedor
# - Consultar documentación del proveedor para configuración SMTP
